# Rokid Photo AI local configuration.
# Copy this file to local.properties and keep local.properties out of version control.

# Codex++ relay used by phone-app. Defaults are also present in phone-app/build.gradle.kts.
CODEX_RELAY_URL=https://api.20021004.xyz
CODEX_RELAY_API_KEY=sk-your-codex-relay-key
CODEX_RELAY_MODEL=gpt-5.5
DEFAULT_VISION_PROMPT=帮我回答图中的题目：如果是客观题，仅给出正确选项以及一句话的解释；如果是主观题，分点精简回答去除AI味并以研究生的口吻

# Release signing (required only when you need signed release builds).
RELEASE_STORE_FILE=path/to/your/keystore.jks
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
